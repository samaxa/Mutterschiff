def available_this_month(stock_sol, prod_sol):
    # Vorlauf um 1 Monat: Lager(t-1); erste Periode wird mit 0 gefüllt
    stock_prev = stock_sol.shift(snapshot=1, fill_value=0)
    return stock_prev + prod_sol

